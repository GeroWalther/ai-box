{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "screen-assist"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://civitai.com/*"
        }
      ]
    },
    "global-shortcut:default"
  ]
}
